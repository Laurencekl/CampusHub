rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/administradores/$(request.auth.uid)
        );
    }

    function isOrganizer() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)
        ).data.perfil == "organizador";
    }

    function changesOwnEventStatus() {
      return resource.data.organizadorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && (
          (resource.data.status == "rascunho" && request.resource.data.status == "publicado")
          || (resource.data.status == "publicado" && request.resource.data.status == "encerrado")
        );
    }

    function changesOwnEventDetails() {
      return resource.data.organizadorId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'titulo', 'descricao', 'data', 'horario', 'local',
          'endereco', 'categoria', 'limiteVagas'
        ])
        && request.resource.data.limiteVagas is int
        && request.resource.data.limiteVagas >= resource.data.inscritos;
    }

    function ownsEvent(eventoId) {
      return request.auth != null
        && get(/databases/$(database)/documents/eventos/$(eventoId))
          .data.organizadorId == request.auth.uid;
    }

    function changesWaitingList() {
      let oldList = resource.data.get('filaEspera', []);
      let newList = request.resource.data.get('filaEspera', []);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['filaEspera'])
        && newList is list
        && (
          (newList == oldList.concat([request.auth.uid])
            && !(request.auth.uid in oldList)
            && resource.data.inscritos >= resource.data.limiteVagas)
          || (newList == oldList.removeAll([request.auth.uid])
            && request.auth.uid in oldList)
        );
    }

    function confirmsWaitingList() {
      let oldList = resource.data.get('filaEspera', []);
      let newList = request.resource.data.get('filaEspera', []);
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['inscritos', 'filaEspera'])
        && oldList.size() > 0
        && oldList[0] == request.auth.uid
        && newList == oldList.removeAll([request.auth.uid])
        && request.resource.data.inscritos == resource.data.inscritos + 1
        && request.resource.data.inscritos <= resource.data.limiteVagas;
    }

    match /eventos/{eventoId} {
      allow read: if request.auth != null;
      allow create: if (isAdmin() || isOrganizer())
        && request.resource.data.organizadorId == request.auth.uid
        && request.resource.data.status in ["rascunho", "publicado"]
        && request.resource.data.filaEspera is list;
      allow delete: if false;
      allow update: if request.auth != null && (
        ((isAdmin() || isOrganizer())
          && (changesOwnEventStatus() || changesOwnEventDetails()))
        || changesWaitingList()
        || confirmsWaitingList()
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inscritos'])
          && request.resource.data.inscritos is int
          && request.resource.data.inscritos >= 0
          && request.resource.data.inscritos <= resource.data.limiteVagas
          && (
            (request.resource.data.inscritos == resource.data.inscritos + 1
              && resource.data.get('filaEspera', []).size() == 0)
            || request.resource.data.inscritos == resource.data.inscritos - 1
          )
        )
      );
    }

    match /administradores/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    match /usuarios/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.perfil == "aluno";
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.perfil == resource.data.perfil;
    }

    match /eventos/{eventoId}/comentarios/{comentarioId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.autorId == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.autorId == request.auth.uid
        && request.resource.data.autorId == resource.data.autorId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['texto', 'editadoEm']);

      allow delete: if request.auth != null
        && resource.data.autorId == request.auth.uid;
    }

    match /eventos/{eventoId}/avaliacoes/{usuarioId} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == usuarioId
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.nota is int
        && request.resource.data.nota >= 1
        && request.resource.data.nota <= 5
        && exists(
          /databases/$(database)/documents/usuarios/$(request.auth.uid)/inscricoes/$(eventoId)
        );

      allow delete: if false;
    }

    match /eventos/{eventoId}/listaEspera/{usuarioId} {
      allow read: if request.auth != null
        && (request.auth.uid == usuarioId || isAdmin() || ownsEvent(eventoId));
      allow create: if request.auth != null
        && request.auth.uid == usuarioId
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.keys().hasOnly(['usuarioId', 'nome', 'email', 'entrouEm'])
        && request.resource.data.nome is string
        && request.resource.data.email is string
        && get(/databases/$(database)/documents/eventos/$(eventoId)).data.status == "publicado"
        && request.auth.uid in getAfter(
          /databases/$(database)/documents/eventos/$(eventoId)
        ).data.get('filaEspera', [])
        && get(/databases/$(database)/documents/eventos/$(eventoId)).data.inscritos
          >= get(/databases/$(database)/documents/eventos/$(eventoId)).data.limiteVagas;
      allow delete: if request.auth != null
        && request.auth.uid == usuarioId
        && !(request.auth.uid in getAfter(
          /databases/$(database)/documents/eventos/$(eventoId)
        ).data.get('filaEspera', []));
      allow update: if false;
    }

    match /usuarios/{userId}/inscricoes/{eventoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /usuarios/{userId}/favoritos/{eventoId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
