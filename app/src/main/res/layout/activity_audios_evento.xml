<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_claro"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/audios_evento_titulo"
        android:textColor="@color/azul_principal"
        android:textSize="27sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textoTituloEventoAudio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/texto_principal"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/audios_evento_descricao"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoGravarAudio"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="18dp"
        android:text="@string/gravar_audio"
        app:cornerRadius="12dp" />

    <TextView
        android:id="@+id/textoSemAudios"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/nenhum_audio_evento"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <ListView
        android:id="@+id/listaAudiosEvento"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:dividerHeight="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoVoltarAudios"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:text="@string/voltar"
        app:cornerRadius="12dp" />
</LinearLayout>
