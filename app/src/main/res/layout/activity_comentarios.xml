<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo_claro"
    android:orientation="vertical"
    android:padding="24dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/azul_principal"
        app:cardCornerRadius="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/comentarios_titulo"
                android:textColor="@color/branco"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textoTituloEventoComentarios"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/azul_cabecalho_claro"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/comentarios_subtitulo"
                android:textColor="@color/azul_cabecalho_claro"
                android:textSize="14sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <EditText
        android:id="@+id/campoComentario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@android:drawable/edit_text"
        android:hint="@string/digite_comentario"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="500"
        android:minHeight="72dp"
        android:padding="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoPublicarComentario"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:text="@string/publicar_comentario"
        app:cornerRadius="12dp" />

    <TextView
        android:id="@+id/textoStatusComentarios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/carregando_comentarios"
        android:textColor="@color/texto_secundario" />

    <ListView
        android:id="@+id/listaComentarios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:divider="@android:color/transparent"
        android:dividerHeight="10dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botaoVoltarComentarios"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/voltar"
        app:cornerRadius="12dp" />
</LinearLayout>
